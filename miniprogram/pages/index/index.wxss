.index { padding-bottom: 60rpx; }

.hero { padding: 12rpx 8rpx 20rpx; }

.continue-card { position: relative; overflow: hidden; }
.continue-card .dot {
  width: 14rpx; height: 14rpx;
  border-radius: 50%;
  background: var(--brand);
  margin-right: 14rpx;
  flex-shrink: 0;
}
.progress-track {
  height: 12rpx;
  background: #EDF1F8;
  border-radius: 12rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #6F94F8, var(--brand));
  border-radius: 12rpx;
  transition: width 0.3s;
}

.card-hover { opacity: 0.92; }

/* 自定义练习入口：从「开始」卡片里单独拉一条，避免挤成第五个方格 */
.custom-entry {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #F8FAFF;
  border: 1rpx solid var(--line);
}
.custom-entry-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--brand);
}
.custom-entry-arrow {
  font-size: 36rpx;
  color: var(--brand);
  opacity: 0.6;
  margin-left: 12rpx;
}

.entry-grid { display: flex; gap: 20rpx; }
.entry {
  flex: 1;
  background: #F8FAFF;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 20rpx;
}
.entry-hover { background: #F1F5FF; }
.entry-icon {
  width: 72rpx; height: 72rpx;
  border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 14rpx;
  position: relative;
}

/* 多栏入口：压缩内边距与字号 */
.entry-grid-3 { gap: 14rpx; }
.entry-grid-3 .entry { padding: 18rpx 12rpx; }
.entry-grid-3 .entry-name { font-size: 26rpx; }
.entry-grid-3 .entry-desc { font-size: 20rpx; }

.entry-grid-4 { gap: 12rpx; }
.entry-grid-4 .entry { padding: 18rpx 8rpx; text-align: center; }
.entry-grid-4 .entry-icon { width: 64rpx; height: 64rpx; margin: 0 auto 12rpx; border-radius: 16rpx; }
.entry-grid-4 .entry-name { font-size: 24rpx; }

/* 数据备份：两个按钮等宽并排 */
.backup-actions { display: flex; gap: 16rpx; }
.backup-actions .btn { flex: 1; min-width: 0; }
.entry-badge {
  position: absolute;
  top: -8rpx; right: -8rpx;
  min-width: 34rpx; height: 34rpx;
  padding: 0 8rpx;
  border-radius: 17rpx;
  background: var(--danger);
  color: #fff;
  font-size: 20rpx;
  line-height: 34rpx;
  text-align: center;
  font-weight: 600;
}
.glyph { position: relative; }
.glyph-add { width: 30rpx; height: 30rpx; }
.glyph-add::before,
.glyph-add::after {
  content: '';
  position: absolute; background: var(--brand); border-radius: 4rpx;
}
.glyph-add::before { left: 13rpx; top: 0; width: 4rpx; height: 30rpx; }
.glyph-add::after { left: 0; top: 13rpx; width: 30rpx; height: 4rpx; }
.glyph-folder {
  width: 34rpx; height: 26rpx;
  border-radius: 6rpx;
  background: var(--success);
  margin-top: 4rpx;
}
.glyph-folder::before {
  content: '';
  position: absolute; left: 0; top: -10rpx;
  width: 16rpx; height: 12rpx;
  background: var(--success);
  border-radius: 6rpx 6rpx 0 0;
  opacity: 0.75;
}
.glyph-wrong {
  width: 30rpx; height: 30rpx;
  border: 5rpx solid var(--danger);
  border-radius: 50%;
  box-sizing: border-box;
}
.glyph-wrong::before {
  content: '';
  position: absolute; left: 12rpx; top: 5rpx;
  width: 5rpx; height: 5rpx;
  background: var(--danger);
  border-radius: 50%;
}
.glyph-wrong::after {
  content: '';
  position: absolute; left: 12rpx; top: 13rpx;
  width: 5rpx; height: 11rpx;
  background: var(--danger);
  border-radius: 3rpx;
}
.glyph-fix {
  width: 28rpx; height: 32rpx;
  border: 4rpx solid var(--warn);
  border-radius: 6rpx;
  box-sizing: border-box;
  margin-top: 4rpx;
}
.glyph-fix::before {
  content: '';
  position: absolute; left: 6rpx; top: -9rpx;
  width: 12rpx; height: 8rpx;
  background: var(--warn);
  border-radius: 4rpx;
}
.glyph-fix::after {
  content: '';
  position: absolute; left: 4rpx; top: 7rpx;
  width: 12rpx; height: 3rpx;
  background: var(--warn);
  border-radius: 2rpx;
  box-shadow: 0 7rpx 0 var(--warn);
}
.entry-name { font-size: 28rpx; font-weight: 600; }
.entry-desc { font-size: 22rpx; color: var(--text-weak); margin-top: 4rpx; }

.section-title { margin: 8rpx 8rpx 16rpx; }

.set-card .ml8 { margin-left: 12rpx; }
.set-card .mb16 { margin: 16rpx 0; }
.set-card .mt16 { margin-top: 18rpx; }
.set-card .mt8 { margin-top: 10rpx; }

.empty-box {
  width: 120rpx; height: 120rpx;
  margin: 0 auto;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #EAF0FE, #E5F6EE);
  position: relative;
}
.empty-box::before {
  content: '';
  position: absolute; left: 42rpx; top: 28rpx;
  width: 36rpx; height: 36rpx;
  border: 5rpx solid var(--brand);
  border-radius: 8rpx;
  transform: rotate(-8deg);
}
.link { color: var(--brand); }

.btn-disabled { opacity: 0.5; }
.center { text-align: center; }

/* 题库管理入口 */
.mg-entry {
  margin-left: 16rpx;
  color: var(--brand);
  font-size: 25rpx;
}
.more-tip {
  padding: 24rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  background: #F8FAFF;
  border: 1rpx dashed #D7E0F5;
  color: var(--text-sub);
  font-size: 25rpx;
  text-align: center;
}
