.result { padding-bottom: 180rpx; }

.hero { text-align: center; padding: 40rpx 0 10rpx; }
.ring {
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ring-inner {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.rate-num { font-size: 72rpx; font-weight: 800; color: var(--text); line-height: 1.1; }
.rate-label { font-size: 26rpx; color: var(--text-weak); }
.hero-title { font-size: 34rpx; font-weight: 600; }
.hero .weak { font-size: 26rpx; }

.stats-card { display: flex; padding: 30rpx 0; }
.stat { flex: 1; text-align: center; }
.stat + .stat { border-left: 1rpx solid var(--line); }
.num { font-size: 40rpx; font-weight: 700; }
.num.green { color: var(--success); }
.num.red { color: var(--danger); }
.num.gray { color: var(--text-sub); }
.stat-label { font-size: 24rpx; color: var(--text-weak); margin-top: 4rpx; }

/* 错题回顾 */
.ml8 { margin-left: 8rpx; }
.hard-item {
  background: #FDF7F7;
  border-radius: 14rpx;
  padding: 18rpx;
  margin-bottom: 14rpx;
}
.hard-item .q-no {
  font-size: 30rpx;
  font-weight: 700;
  margin-right: 12rpx;
}
.hard-stem {
  font-size: 27rpx;
  line-height: 1.6;
  color: var(--text-sub);
  margin-top: 10rpx;
}
